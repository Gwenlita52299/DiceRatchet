{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diceratchet.local/schemas/inference_call.schema.json",
  "title": "InferenceCallRecord",
  "description": "MOD-03 每次尝试一条的推理埋点（PRD §13），落 runs/<run_id>/metrics/llm_calls.jsonl（落盘归 MOD-09）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "call_id", "ts", "event", "model_id", "backend", "mode", "purpose", "caller",
    "prompt_digest", "prompt_tokens", "completion_tokens", "max_tokens",
    "temperature", "top_p", "top_k", "repetition_penalty", "grammar_used", "json_mode",
    "latency_ms", "attempt", "attempts", "retry_reasons", "outcome_kind", "finish_reason"
  ],
  "properties": {
    "call_id": { "type": "string", "pattern": "^c-[0-9]{6,}$" },
    "run_id": { "type": ["string", "null"] },
    "ts": { "type": "string", "pattern": "Z$" },
    "event": { "const": "llm_call" },
    "episode_id": { "type": ["string", "null"] },
    "generation": { "type": ["integer", "null"], "minimum": 0 },
    "harness_version": { "type": ["integer", "null"], "minimum": 0 },
    "seed": { "type": ["integer", "null"] },
    "step": { "type": ["integer", "null"], "minimum": 0 },
    "model_id": { "type": "string" },
    "backend": { "enum": ["mlx", "llama_cpp", "llama_server", "mock"] },
    "mode": { "enum": ["train", "eval"] },
    "purpose": { "type": "string" },
    "schema_id": { "type": ["string", "null"] },
    "caller": { "type": "string" },
    "prompt_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "prompt_tokens": { "type": "integer", "minimum": 0 },
    "completion_tokens": { "type": "integer", "minimum": 0 },
    "cache_hit_tokens": { "type": "integer", "minimum": 0 },
    "cache_miss_tokens": { "type": "integer", "minimum": 0 },
    "cache_hit_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "max_tokens": { "type": "integer", "minimum": 1 },
    "temperature": { "type": "number", "minimum": 0, "maximum": 1.5 },
    "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "top_k": { "type": "integer", "minimum": 0, "maximum": 200 },
    "repetition_penalty": { "type": "number", "minimum": 1.0, "maximum": 1.5 },
    "sampling_seed": { "type": ["integer", "null"] },
    "grammar_used": { "type": "boolean" },
    "json_mode": { "type": "boolean" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "ttft_ms": { "type": ["integer", "null"], "minimum": 0 },
    "prefill_ms": { "type": ["integer", "null"], "minimum": 0 },
    "decode_ms": { "type": ["integer", "null"], "minimum": 0 },
    "tok_per_s": { "type": ["number", "null"], "minimum": 0 },
    "attempt": { "type": "integer", "minimum": 1 },
    "attempts": { "type": "integer", "minimum": 1 },
    "retry_reasons": { "type": "array", "items": { "type": "string" } },
    "outcome_kind": { "enum": ["action", "degraded", "error"] },
    "finish_reason": { "enum": ["stop", "length", "timeout", "error"] },
    "degraded_reason": { "type": ["string", "null"] },
    "error_code": { "type": ["string", "null"] },
    "resident_gb": { "type": ["number", "null"], "minimum": 0 },
    "inflight": { "type": ["integer", "null"], "minimum": 0 }
  }
}
