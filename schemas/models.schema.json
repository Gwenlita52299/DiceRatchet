{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diceratchet.local/schemas/models.schema.json",
  "title": "ModelRegistry",
  "description": "MOD-03 `configs/models.yaml` 模型注册表（PRD §7）。静态注册表：M1–M3 不参与 harness 演化，只允许人工变更并记 CHANGELOG（NFR-03-04）。Issue #1：新增 provider/api_* 描述字段，供角色绑定与 run provenance 使用。",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "models"],
  "properties": {
    "registry_version": { "const": 1 },
    "ram_budget_gb": { "type": "number", "exclusiveMinimum": 0 },
    "fallback_backend": {
      "enum": ["mlx", "llama_cpp", "llama_server", "mock", "deepseek"],
      "description": "加载失败换后端重试 1 次的目标（PRD §10）"
    },
    "defaults": { "$ref": "#/$defs/defaults" },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context_length": { "type": "integer", "minimum": 128 },
        "kv_cache_bits": { "enum": [4, 8, 16] },
        "max_inflight": { "type": "integer", "minimum": 1, "maximum": 64 },
        "quantization": { "type": "string" },
        "supports_grammar": { "type": "boolean" },
        "supports_json_mode": { "type": "boolean" },
        "kv_gb_per_1k_tokens": { "type": "number", "minimum": 0 },
        "perf_budget": { "$ref": "#/$defs/perf_budget" },
        "provider": { "enum": ["local", "api"] },
        "online": { "type": "boolean" },
        "family": { "type": "string" },
        "params_b": { "type": "number", "minimum": 0 },
        "api_base": { "type": "string" },
        "api_key_env": { "type": "string" },
        "api_supports_seed": { "type": "boolean" },
        "cost_per_1k_input": { "type": "number", "minimum": 0 },
        "cost_per_1k_output": { "type": "number", "minimum": 0 },
        "cost_currency": { "type": "string" },
        "cost_basis": { "type": "string" }
      }
    },
    "perf_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p50_latency_ms": { "type": "integer", "minimum": 1 },
        "p95_latency_ms": { "type": "integer", "minimum": 1 },
        "min_tok_per_s": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "context_length"],
      "properties": {
        "backend": { "enum": ["mlx", "llama_cpp", "llama_server", "mock", "deepseek"] },
        "weights_path": { "type": ["string", "null"] },
        "weights_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "description": "缺失（null）时跳过校验；CI 要求填写（Q-6）"
        },
        "tokenizer_path": { "type": ["string", "null"] },
        "quantization": { "type": "string" },
        "context_length": { "type": "integer", "minimum": 128 },
        "kv_cache_bits": { "enum": [4, 8, 16] },
        "resident_gb_est": { "type": "number", "minimum": 0 },
        "kv_gb_per_1k_tokens": { "type": "number", "minimum": 0 },
        "max_inflight": { "type": "integer", "minimum": 1, "maximum": 64 },
        "supports_grammar": { "type": "boolean" },
        "supports_json_mode": { "type": "boolean" },
        "fallback_backend": { "enum": ["mlx", "llama_cpp", "llama_server", "mock", "deepseek", null] },
        "server_args": { "type": "array", "items": { "type": "string" } },
        "default_sampling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": { "type": "number", "minimum": 0, "maximum": 1.5 },
            "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "top_k": { "type": "integer", "minimum": 0, "maximum": 200 },
            "repetition_penalty": { "type": "number", "minimum": 1.0, "maximum": 1.5 }
          }
        },
        "perf_budget": { "$ref": "#/$defs/perf_budget" },
        "family": { "type": "string" },
        "params_b": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" },
        "provider": {
          "enum": ["local", "api"],
          "description": "模型提供方：local（本地权重/进程）/ api（远程 API）。缺省由 backend 推导"
        },
        "online": {
          "type": "boolean",
          "description": "显式在线标记；API 模式必须为 true（不许把远程调用记成本地）"
        },
        "model_revision": {
          "type": ["string", "null"],
          "description": "服务方发布的版本号（若提供）；API 响应的 model 字段会覆盖为实际 revision"
        },
        "api_base": { "type": ["string", "null"], "description": "OpenAI 兼容 base URL" },
        "api_model": { "type": ["string", "null"], "description": "请求体里的 model 名" },
        "api_key_env": {
          "type": ["string", "null"],
          "description": "API key 所在的环境变量名。key 本身绝不落盘（run JSON / Git / prompt）"
        },
        "api_supports_seed": {
          "type": "boolean",
          "description": "服务方是否接受 seed 参数（不承诺跨时间严格确定性，见 Issue #1「可复现性」）"
        },
        "api_thinking": {
          "enum": ["enabled", "disabled", ""],
          "description": "思考模式开关（OpenAI 格式 thinking.type）；空串 = 不发送、用服务方默认"
        },
        "cost_per_1k_input": { "type": "number", "minimum": 0 },
        "cost_per_1k_output": { "type": "number", "minimum": 0 },
        "cost_currency": { "type": "string" },
        "cost_basis": { "type": "string" }
      }
    }
  }
}
